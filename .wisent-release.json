{
  "schema_version": 1,
  "product": "wisent-desktop-auth",
  "releases": true,
  "version_source": {
    "kind": "json",
    "path": "released-surface.json",
    "pointer": "/version"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "compile",
          "argv": [
            "bash",
            "release/build.sh",
            "compile"
          ]
        }
      ],
      "build": {
        "argv": [
          "bash",
          "release/build.sh",
          "build"
        ]
      },
      "stage": {
        "dist/wisent-desktop-auth-source.tar.gz": "source/wisent-desktop-auth-source.tar.gz",
        "dist/SOURCE_REVISION": "SOURCE_REVISION",
        "dist/build-evidence.json": "evidence/build-evidence.json"
      }
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  }
}
